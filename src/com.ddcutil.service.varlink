# SPDX-License-Identifier: GPL-2.0-or-later

interface com.ddcutil.DdcutilInterface

error DisplayNotFound (display_number: int, edid_base64: string)
error DdcError(display_ref: int, display_number: int, edid_base64: string, status: int, message: string)
error DetectError(status: int, message: string)
error ConfigurationLocked ()

type DetectEntry (
    display_number: int,
    usb_bus: int,
    usb_device: int,
    mfg_id: string,
    model_name: string,
    serial: string,
    product_code: int,
    edid_base64: string,
    binary_serial: int,
    display_ref: int
)

type VcpValue (
    vcp_code: int,
    current: int,
    maximum: int,
    formatted: string
)

type CapabilitiesValueEntry (
    #[rust_type = "u8"]
    value_code: int,
    value_name: string
)

type CapabilitiesFeature (
    feature_name: string,
    feature_description: string,
    values: []CapabilitiesValueEntry
)

# For dictionaries with integer keys, we use arrays of key-value pairs.
type KeyValueIntString (
    key: int,
    value: string
)

type KeyValueIntCapabilitiesFeature (
    key: int,
    value: CapabilitiesFeature
)

# Event data formats:
# - kind: "service_initialized" → data: {}
# - kind: "vcp_changed" → data: {"display_number": int, "edid_base64": string, "vcp_code": int, "new_value": int}
# - kind: "connected_displays_changed" → data: {"edid_base64": string, "event_type": int, "flags": int}
type Event (
    kind: (service_initialized, connected_displays_changed, vcp_changed, stream_closed),
    data: string
)

# Optional method flags.
# Not all flags are meaningful for all methods.
type CallOptions (
    allow_edid_prefix: ?bool,     # Allow EDID prefix matches. If prefix not unique, first match wins.
    no_verify: ?bool              # Request libddcutil not to verify the set_vcp worked.
)

# Detect may be able to detect offline/powered-off displays if connected by DVI,
# include_offline=false matches normal ddcutil behaviour.
# Cannot make this single parameter optional, must have at least one non-optional or none (parsing will fail).
method Detect(include_offline: bool) -> (count: int, displays: []DetectEntry, status: int, message: string)
method ListDetected(include_offline: bool) -> (count: int, displays: []DetectEntry, status: int, message: string)

method GetVcp(
    display_number: ?int,
    edid_base64: ?string,
    vcp_code: int,
    options: ?CallOptions
) -> (
    current: int,
    maximum: int,
    formatted: string,
    status: int,
    message: string
)

method GetMultipleVcp(
    display_number: ?int,
    edid_base64: ?string,
    vcp_codes: []int,
    options: ?CallOptions
) -> (
    values: []VcpValue,
    status: int,
    message: string
)

method SetVcp(
    display_number: ?int,
    edid_base64: ?string,
    vcp_code: int,
    new_value: int,
    client_context: ?string,
    options: ?CallOptions
) -> (
    status: int,
    message: string
)

method GetVcpMetadata(
    display_number: ?int,
    edid_base64: ?string,
    vcp_code: int,
    options: ?CallOptions
) -> (
    feature_name: string,
    feature_description: string,
    is_read_only: bool,
    is_write_only: bool,
    is_rw: bool,
    is_complex: bool,
    is_continuous: bool,
    status: int,
    message: string
)

method GetCapabilitiesString(
    display_number: ?int,
    edid_base64: ?string,
    options: ?CallOptions
) -> (
    capabilities_text: string,
    status: int,
    message: string
)

method GetCapabilitiesMetadata(
    display_number: ?int,
    edid_base64: ?string,
    options: ?CallOptions
) -> (
    model_name: string,
    mccs_major: int,
    mccs_minor: int,
    commands: []KeyValueIntString,
    capabilities: []KeyValueIntCapabilitiesFeature,
    status: int,
    message: string
)

method GetDisplayState(
    display_number: ?int,
    edid_base64: ?string,
    options: ?CallOptions
) -> (
    status: int,
    message: string
)

method GetSleepMultiplier(
    display_number: ?int,
    edid_base64: ?string,
    options: ?CallOptions
) -> (
    multiplier: float
)

method SetSleepMultiplier(
    display_number: ?int,
    edid_base64: ?string,
    new_multiplier: float,
    options: ?CallOptions
) -> (
    status: int,
    message: string
)

method GetStatusValues() -> (status_map: []KeyValueIntString)

method GetDdcutilVersion() -> (version: string)

method GetDdcutilDynamicSleep() -> (enabled: bool)
method SetDdcutilDynamicSleep(enabled: bool) -> ()

method GetDdcutilOutputLevel() -> (level: int)
method SetDdcutilOutputLevel(level: int) -> ()

method GetServiceInterfaceVersion() -> (version: string)

method GetServiceInfoLogging() -> (enabled: bool)
method SetServiceInfoLogging(enabled: bool) -> ()

method GetServicePollInterval() -> (seconds: int)
method SetServicePollInterval(seconds: int) -> ()

method GetServicePollCascadeInterval() -> (seconds: float)
method SetServicePollCascadeInterval(seconds: float) -> ()

# Use polling for connectivity changes including DPMS events
# Note: libddcutil doesn't cover DPMS events. Depending on the
# GPU driver, GPU, and display, polling for DPMS changes may
# not working.
method Subscribe(use_polling: bool) -> (event: Event)
